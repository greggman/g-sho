# Cache headers for Cloudflare Workers Static Assets.
#
# Files without a rule here (the pages, app.js, style.css, the workers) get
# Cloudflare's default: revalidate on every load (a cheap 304 when
# unchanged). They aren't content-hashed, so they must always come from the
# same deploy as each other; a cached app.js from an older deploy would load
# chunks that no longer exist.

# Bundled chunks have content hashes in their names: they never change.
/chunks/*
  Cache-Control: public, max-age=31536000, immutable

# Data files are requested with ?v=<their data set's content hash> (see
# meta.json "versions"): changed data is a new URL, so they never go stale.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# ...except meta.json, which says what the current version is.
/data/meta.json
  ! Cache-Control
  Cache-Control: no-cache
